# .env.example — Safe example values for environment variables.
#
# Copy this file to .env and adjust the values for your environment.
# NEVER commit .env to Git — it is excluded in .gitignore.
#
#   cp .env.example .env

# Port published to the host by the Nginx reverse proxy.
# Change this if 8080 is already in use on your machine.
NGINX_PORT=8080

# Application environment label (informational; not used by the static app).
# Set to "development" during local work.
APP_ENV=production

