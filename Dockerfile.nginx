# Dockerfile — Reverse proxy container
#
# Extends the official Nginx image with our proxy configuration.
# This container is the only one that publishes a port to the host.
#
# Base image: nginx:1.27-alpine — matches the app container for consistency
# and keeps the image small.

FROM nginx:1.27-alpine

# Remove the default Nginx configuration.
RUN rm /etc/nginx/conf.d/default.conf

# Copy our reverse-proxy configuration into place.
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Port 80 is mapped to the host by Docker Compose (NGINX_PORT env var).
EXPOSE 80

# Health check: use 127.0.0.1 (not localhost) because on Alpine Linux,
# localhost may resolve to ::1 (IPv6) while Nginx only listens on IPv4.
# /healthz is served directly by Nginx — no dependency on the upstream app.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
